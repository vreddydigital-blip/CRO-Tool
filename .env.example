# =============================================================================
# CRO Intelligence — environment template
# =============================================================================
# This file is committed to git. It contains NO secrets.
# Copy it to .env locally, or paste these keys into the EthioDeploy dashboard.
#
#   Local:  cp .env.example .env && php artisan key:generate
#
# On EthioDeploy you do NOT need to set every key below — only the ones marked
# [SET IN DASHBOARD]. The rest already have safe defaults in config/.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="CRO Intelligence"

# [SET IN DASHBOARD] production on the live site, local on your machine.
APP_ENV=production

# [SET IN DASHBOARD] Generate with: php artisan key:generate --show
# Paste the whole "base64:..." string. Never commit the real value.
APP_KEY=

# [SET IN DASHBOARD] false in production. true leaks stack traces and env values.
APP_DEBUG=false

# [SET IN DASHBOARD] Your live https URL, no trailing slash.
# e.g. https://cro-intelligence.ethiodeploy.com
# Wrong value here breaks asset URLs, redirects and password-reset links.
APP_URL=https://your-app.ethiodeploy.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# --- Security ----------------------------------------------------------------
# bcrypt cost. 12 is a good production default; lower only if login feels slow.
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# [SET IN DASHBOARD] "error" in production. "debug" writes far more and can
# record request data you would rather not keep.
LOG_LEVEL=error

# --- Database ----------------------------------------------------------------
# EthioDeploy injects a single connection string as DATABASE_URL, e.g.
#   mysql://user:pass@host:3306/dbname
# Laravel reads DB_URL first and falls back to DATABASE_URL (see
# config/database.php). You normally do NOT need to set DB_* by hand.
#
# If your host gives you separate values instead of a URL, set DB_HOST,
# DB_PORT, DB_DATABASE, DB_USERNAME and DB_PASSWORD and leave DB_URL empty.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cro_intelligence
DB_USERNAME=root
DB_PASSWORD=

# Optional explicit override. Leave blank to use DATABASE_URL from the host.
DB_URL=

# --- Sessions ----------------------------------------------------------------
# [SET IN DASHBOARD] MUST be "database" on EthioDeploy.
# The free plan's filesystem is wiped on every deploy, so file-based sessions
# log everyone out each time you push. The sessions table ships in the
# migrations, so this works with no extra setup.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Cache / queue / storage -------------------------------------------------
# No Redis on the free plan. File cache is fine for this app's small footprint.
CACHE_STORE=file

# No persistent worker on the free plan. "sync" runs jobs inline, which is what
# the crawler expects — do not change this to "database" without a worker.
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail --------------------------------------------------------------------
# No SMTP on the free plan, so password-reset emails are written to the log
# instead of being sent. To make them real, point these at a free transactional
# provider (Brevo, Resend, Mailgun free tier) and set MAIL_MAILER=smtp.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend ----------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# --- Optional AI explanation layer -------------------------------------------
# The app works fully WITHOUT these. When AI_API_KEY is empty it uses the
# built-in rule-based explainer, which needs no network call and no key.
# Leave all three blank unless you want AI-written recommendations.
# Any OpenAI-compatible endpoint works (OpenAI, Groq, OpenRouter, local Ollama).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
